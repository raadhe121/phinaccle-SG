{
    "cli": {
        "appVersionSource": "remote"
    },
    "build": {
        "development-simulator": {
            "developmentClient": true,
            "distribution": "internal",
            "ios": {
                "simulator": true
            }
        },
        "development": {
            "channel": "development",
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            }
        },
        "preview": {
            "channel": "preview",
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            }
        },
        "production": {
            "channel": "production",
            "autoIncrement": true,
            "env": {
                "APP_VARIANT": "production"
            }
        },
        "preview-internal": {
            "channel": "preview",
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            }
        },
        "production-internal": {
            "channel": "production",
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "APP_VARIANT": "production"
            }
        }
    }
}